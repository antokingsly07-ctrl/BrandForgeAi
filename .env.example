# ============================================================
# BrandForge AI — Environment Variables
# ------------------------------------------------------------
# All variables are OPTIONAL. Without an API key, the app runs
# in "Simulated AI" mode (clearly labelled in the UI) so you can
# explore the entire workflow with zero configuration.
# ============================================================

# --- AI Provider --------------------------------------------------
# Select the AI provider: "auto" (default) | "openai" | "nvidia" | "mock"
# "auto"      -> uses OpenAI-compatible provider if AI_API_KEY is set,
#                NVIDIA Nemotron if only NVIDIA_API_KEY is set,
#                otherwise falls back to the simulated provider.
# "openai"    -> force the real OpenAI-compatible provider (requires a key).
# "nvidia"    -> force NVIDIA-hosted Nemotron 3.5 Lightning
#                (requires NVIDIA_API_KEY, or AI_API_KEY holding an nvapi- key).
# "mock"      -> force the simulated provider (no key required, free).
AI_PROVIDER=auto

# --- OpenAI-compatible API ----------------------------------------
# Standard OpenAI credentials. Any OpenAI-compatible endpoint works
# (OpenAI, Azure OpenAI, OpenRouter, Groq, Together, local Ollama, etc.)
AI_API_KEY=sk-xxxx
AI_MODEL=gpt-4o-mini
# Leave empty for the default https://api.openai.com/v1
AI_BASE_URL=

# --- NVIDIA Nemotron 3.5 Lightning --------------------------------
# Hosted at https://integrate.api.nvidia.com/v1 (OpenAI-compatible).
# Get a key at https://build.nvidia.com (starts with nvapi-).
# Recommended: set AI_PROVIDER=nvidia plus NVIDIA_API_KEY below, and leave
# AI_MODEL / AI_BASE_URL empty to use the Nemotron 3.5 Lightning defaults.
# NVIDIA_API_KEY=nvapi-xxxx

# HTTP timeout for AI calls, in milliseconds (default 90000)
AI_TIMEOUT_MS=

# Max output tokens per AI call (default 8000). Reasoning models can emit
# very long thinking traces without a cap and hit timeouts; lower this if
# generations are slow, raise it if large outputs get cut off.
# AI_MAX_TOKENS=

# --- Server --------------------------------------------------------
# Directory used to persist projects as JSON (defaults to ./data)
# DATA_DIR=
# Port for `next start` (default 3000)
# PORT=3000

# --- Shared storage (REQUIRED on Vercel) ------------------------------
# Vercel serverless functions share no filesystem: without these, a project
# created on one instance is invisible to the next ("Project not found").
# In Vercel: Storage -> Create Database -> Upstash Redis, connect it to this
# project (env vars are added automatically), then redeploy.
# Locally you can leave these empty (JSON file store is used instead).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=